{
  "name": "helpiesb-backend",
  "version": "1.1.0",
  "description": "API Backend para o aplicativo HelpIesb - PI3A IESB (agora com MySQL + Prisma e Gestor Académico)",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "db:generate": "npx prisma generate",
    "db:migrate": "npx prisma migrate dev --name init",
    "db:seed": "node prisma/seed.js",
    "db:studio": "npx prisma studio"
  },
  "keywords": ["helpiesb", "iesb", "api", "express", "prisma", "mysql"],
  "author": "Pedro Braga, Nícolas Lopes, Leonardo Lustosa",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "prisma": "^5.22.0"
  }
}
